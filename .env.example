# APP_URL: The URL where this applet is hosted.
# Automatically injected at runtime with the service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VAULT_DB_KEY: Optional. Master key used for server-side file encryption.
# If not provided, a default secure key will be used.
VAULT_DB_KEY=
